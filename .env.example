# ══ Provider 1：视觉 LLM（固定为 SiliconFlow，必填）────────────────────────
# SiliconFlow API Key（https://cloud.siliconflow.cn 控制台获取）
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here

# base_url 固定指向 SiliconFlow，一般无需修改：
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# describe_image 工具固定使用的视觉 LLM（不支持按任务切换，改此值需重启服务）。
VISION_CHAT_MODEL=Qwen/Qwen3.5-4B

# ══ Provider 2：编排 Agent（独立配置，可指向任意 OpenAI 兼容服务，必填）────
# 负责驱动 ReAct Agent 决定调用哪个工具（read_file_lines / describe_image /
# write_file_lines），需具备 Tool Calling 能力；与上面的视觉 Provider 完全
# 独立，可以是 OpenAI 官方、Azure、SiliconFlow，或自建的 LiteLLM/Ollama 等
# 兼容网关。
OPENAI_API_KEY=sk-your-orchestrator-api-key-here
# 留空则使用 OpenAI 官方端点；如需自定义（如下方示例）请取消注释：
# OPENAI_BASE_URL=https://api.openai.com/v1
ORCHESTRATOR_MODEL=gpt-4o-mini

# 视觉/编排 LLM 调用固定的随机数种子，配合 temperature=0 尽量提升多次调用结果
# 的一致性（best effort，非硬保证：共享云推理服务仍可能因服务端批处理导致的
# 浮点误差产生不同输出）。留空/设为空字符串可禁用该参数。
LLM_SEED=42

# 单页 LLM 调用超时（秒，仅影响视觉 Provider 的调用）
PAGE_TIMEOUT=120

# 视觉模型单次输出最大 token 数（硬性上限，防止模型陷入重复输出循环时无限生成）。
# 留空/注释掉此行则按 VISION_CHAT_MODEL 自动探测（分层兜底：内置模型表 →
# 可选的 litellm 注册表 → 前缀模糊匹配 → 保守默认值 2048，详见 model_registry.py）。
# 显式设置时优先级最高，固定生效。
# VISION_MAX_TOKENS=4000

# httpx / SDK 层重试次数
MAX_RETRIES=2

# 业务层重试（网络抖动、连接中断、429，仅影响视觉 Provider 的调用）
RETRY_ATTEMPTS=4
RETRY_WAIT_MIN=2
RETRY_WAIT_MAX=60
RATE_LIMIT_WAIT=15

# ── PDF 渲染 ──────────────────────────────────
PDF_DPI=150

# ── Web 服务 ──────────────────────────────────
HOST=0.0.0.0
PORT=8000
TASKS_DIR=./tasks
MAX_CONCURRENT_TASKS=3
